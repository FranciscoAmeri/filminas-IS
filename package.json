{
  "name": "filminas-is",
  "version": "1.0.0",
  "description": "Presentaciones de Ingeniería de Software (reveal-md)",
  "main": "index.js",
  "scripts": {
    "start": "reveal-md slides -w",
    "preview": "npm run build && node -e \"require('fs').copyFileSync('slides/index.html','public/index.html')\" && npx --yes serve public",
    "build": "reveal-md slides --static public && node -e \"require('fs').cpSync('slides/guias','public/guias',{recursive:true})\"",
    "deploy": "npm run build && node -e \"require('fs').copyFileSync('slides/index.html','public/index.html')\" && gh-pages -d public -b gh-pages"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FranciscoAmeri/filminas-IS.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/FranciscoAmeri/filminas-IS/issues"
  },
  "homepage": "https://franciscoameri.github.io/filminas-IS/",
  "dependencies": {
    "gh-pages": "^6.3.0",
    "reveal-md": "^6.1.4"
  }
}
